{
  "questions_per_repository": 4,
  "concurrency": 16,
  "max_author_attempts_per_repository": 24,
  "max_evidence_packs": 32,
  "evidence_characters": 24000,
  "source_excerpt_characters": 36000,
  "max_iterations": 25,
  "max_context_tokens": 32768,
  "context_warning_threshold": 0.825,
  "episode_timeout_seconds": 3600,
  "minimum_free_gib": 5,
  "tools_image": "corets-tools:93ac6a4",
  "seed": 42,
  "models": {
    "scanner": {"model": "YOUR_SCANNER_MODEL", "api_key_env": "SCANNER_API_KEY", "base_url_env": "SCANNER_BASE_URL", "parameters": {"temperature": 0.4, "top_p": 1, "max_tokens": 4096}},
    "author": {"model": "YOUR_AUTHOR_MODEL", "api_key_env": "AUTHOR_API_KEY", "base_url_env": "AUTHOR_BASE_URL", "parameters": {"temperature": 0.7, "top_p": 1, "max_tokens": 8192}},
    "teacher": {"model": "glm-5.2", "api_key_env": "TEACHER_API_KEY", "base_url_env": "TEACHER_BASE_URL", "parameters": {"temperature": 1, "top_p": 1, "max_tokens": 128000, "thinking": {"type": "enabled", "clear_thinking": false}, "reasoning_effort": "max"}},
    "reviewer": {"model": "YOUR_REVIEWER_MODEL", "api_key_env": "REVIEWER_API_KEY", "base_url_env": "REVIEWER_BASE_URL", "parameters": {"temperature": 0, "max_tokens": 32768, "reasoning_effort": "high"}}
  },
  "quality_thresholds": {"correctness": 9, "completeness": 9, "relevance": 8, "clarity": 7, "reasoning": 8, "grounding": 8}
}
